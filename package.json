{
  "name": "chridev",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "NODE_OPTIONS=--no-deprecation payload build",
    "ci": "NODE_OPTIONS=--no-deprecation payload migrate && bun run build",
    "start": "next start -p 3010",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "cv": "NODE_OPTIONS=--no-deprecation payload run scripts/build-cv.tsx",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@payloadcms/db-vercel-postgres": "4.0.0-canary.36",
    "@payloadcms/next": "4.0.0-canary.36",
    "@payloadcms/richtext-lexical": "4.0.0-canary.36",
    "@payloadcms/storage-vercel-blob": "4.0.0-canary.36",
    "@payloadcms/translations": "4.0.0-canary.36",
    "@payloadcms/ui": "4.0.0-canary.36",
    "@tabler/icons-react": "^3.46.0",
    "@vercel/analytics": "^2.0.1",
    "cn": "^0.3.0",
    "graphql": "^16",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "payload": "4.0.0-canary.36",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "simple-icons": "^16.32.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
